# Copy to .env.local and fill in. Without the Supabase values the site runs in "demo mode":
# everything works as a guest (progress saved in the browser) and accounts are disabled.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Either the new publishable key (sb_publishable_...) or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Used after server-side grading to write progress, issue certificates,
# promote teachers and delete accounts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Public URL of the site (used in auth email links and on certificates). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Optional: a secret (8+ characters) that lets a signed-in user upgrade themselves to a teacher
# from Account → Classes. Leave empty to only allow teachers promoted via SQL.
TEACHER_INVITE_CODE=
